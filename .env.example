# ==============================================================================
# Navratri Navshakti: Restore the Utsav (GDSC)
# Environment Configuration Template
# ==============================================================================

# Google Form URL for official live leaderboard submissions
# Create a Google Form with fields: Team Name, Total Score, Active Quest Time, Verification Token
VITE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSc_YOUR_GDSC_NAVRATRI_FORM_ID/viewform

# Published Google Sheet / Excel CSV link for global leaderboard sync (defaults to /leaderboard.csv)
# To publish a Google Sheet: File -> Share -> Publish to web -> Format: CSV
VITE_LEADERBOARD_CSV_URL=/leaderboard.csv

# Set to "true" to unlock all 9 days immediately for test environment, debugging, or live presentations
VITE_UNLOCK_ALL=false

# Toast notification duration in milliseconds (default 2000ms for fast auto-dismissal)
VITE_TOAST_DURATION=2000

# Optional Organization and Event Name Customizations
VITE_EVENT_NAME="Navratri Navshakti: Restore the Utsav"
VITE_ORGANIZER="GDSC (Google Developer Student Club)"
VITE_ORGANIZER_SHORT="GDSC"

# Scoring Engine Configuration
VITE_BASE_DAY_SCORE=100
VITE_HINT_PENALTY=5
VITE_WRONG_ATTEMPT_PENALTY=5
VITE_MIN_DAY_SCORE=40
